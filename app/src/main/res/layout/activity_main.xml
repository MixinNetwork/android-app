<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="one.mixin.android.ui.home.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- GONE on phones. A gone rail collapses, so root_view starts at the parent again. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/home_rail"
            android:layout_width="72dp"
            android:layout_height="0dp"
            android:background="?attr/bg_white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <one.mixin.android.ui.home.BottomNavigationBackdropView
            android:id="@+id/bottom_nav_backdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToOutline="true"
            android:elevation="@dimen/home_navigation_glass_elevation"
            android:importantForAccessibility="no"
            android:outlineAmbientShadowColor="@color/home_navigation_glass_shadow_ambient"
            android:outlineSpotShadowColor="@color/home_navigation_glass_shadow_spot"
            tools:targetApi="p"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/bottom_nav"
            app:layout_constraintBottom_toBottomOf="@id/bottom_nav"
            app:layout_constraintStart_toStartOf="@id/bottom_nav"
            app:layout_constraintEnd_toEndOf="@id/bottom_nav" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="0dp"
            android:layout_height="@dimen/home_navigation_height"
            android:layout_marginHorizontal="@dimen/margin20"
            android:layout_marginBottom="@dimen/padding8"
            android:background="@drawable/bg_bottom_navigation"
            android:clipToOutline="true"
            android:elevation="@dimen/home_navigation_elevation"
            android:outlineAmbientShadowColor="@color/home_navigation_shadow_ambient"
            android:outlineSpotShadowColor="@color/home_navigation_shadow_spot"
            tools:targetApi="p"
            app:elevation="@dimen/home_navigation_elevation"
            app:menu="@menu/bottom_navigation"
            app:labelVisibilityMode="labeled"
            app:itemIconSize="22dp"
            app:itemPaddingTop="8dp"
            app:itemPaddingBottom="12dp"
            app:itemTextColor="@color/bottom_navigation_item"
            app:itemTextAppearanceActive="@style/BottomItemTextAppearance.Active"
            app:itemTextAppearanceInactive="@style/BottomItemTextAppearance"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/root_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/bg_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/home_rail"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_marginTop="56dp"
        android:id="@+id/container_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/internal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>

