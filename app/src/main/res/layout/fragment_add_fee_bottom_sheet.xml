<?xml version="1.0" encoding="utf-8"?>
<one.mixin.android.widget.BottomSheetLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_upper_round"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <TextView
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineHeight="20sp"
            android:maxWidth="240dp"
            android:singleLine="true"
            android:text="@string/Add"
            android:textColor="?attr/text_primary"
            android:textFontWeight="500"
            android:textSize="16sp"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/subtitle_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:layout_below="@id/title_tv"
            android:gravity="center"
            android:lineHeight="16sp"
            android:singleLine="true"
            android:textColor="?attr/text_assist"
            android:textSize="12sp"
            tools:ignore="UnusedAttribute" />

        <ImageView
            android:id="@+id/right_iv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="7dp"
            android:background="@drawable/mixin_ripple"
            android:padding="9dp"
            android:src="@drawable/ic_circle_close_window"
            tools:ignore="ContentDescription" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/bg_white"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <RelativeLayout
            android:id="@+id/swap_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_round_card"
            android:minHeight="64dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <ImageView
                android:id="@+id/swap_asset_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_fee_swap"
                app:tint="?attr/text_assist" />

            <TextView
                android:id="@+id/swap_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@id/swap_asset_icon"
                android:lineHeight="20sp"
                android:text="@string/swap_token"
                android:textColor="?attr/text_primary"
                android:textSize="16sp"
                android:textFontWeight="500"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/swap_desc_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/swap_tv"
                android:layout_marginTop="3dp"
                android:lineHeight="18sp"
                android:layout_toEndOf="@id/swap_asset_icon"
                android:text="@string/swap_token_description"
                android:textColor="?attr/text_assist"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/transfer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ripple_round_card"
            android:minHeight="64dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <ImageView
                android:id="@+id/transfer_asset_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="12dp"
                android:rotation="270"
                android:src="@drawable/ic_fee_swap"
                app:tint="?attr/text_assist" />

            <TextView
                android:id="@+id/transfer_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@id/transfer_asset_icon"
                android:lineHeight="20sp"
                android:text="@string/transfer_token"
                android:textColor="?attr/text_primary"
                android:textSize="16sp"
                android:textFontWeight="500"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/transfer_tv"
                android:layout_marginTop="3dp"
                android:lineHeight="18sp"
                android:layout_toEndOf="@id/transfer_asset_icon"
                android:text="@string/transfer_token_description"
                android:textColor="?attr/text_assist"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/deposit_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ripple_round_card"
            android:minHeight="64dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp">

            <ImageView
                android:id="@+id/deposit_asset_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_fee_deposit"
                app:tint="?attr/text_assist" />

            <TextView
                android:id="@+id/deposit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@id/deposit_asset_icon"
                android:lineHeight="20sp"
                android:text="@string/deposit_token"
                android:textColor="?attr/text_primary"
                android:textSize="16sp"
                android:textFontWeight="500"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/deposit_tv"
                android:layout_marginTop="3dp"
                android:lineHeight="18sp"
                android:layout_toEndOf="@id/deposit_asset_icon"
                android:text="@string/deposit_token_description"
                android:textColor="?attr/text_assist"
                android:textSize="13sp"
                tools:ignore="UnusedAttribute" />

        </RelativeLayout>
    </LinearLayout>
</one.mixin.android.widget.BottomSheetLinearLayout>

