<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg_window"
    android:orientation="vertical">

    <one.mixin.android.widget.TitleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bg_window"
        app:need_divider="false"
        app:titleText="@string/New_Group" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/group_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_circle_white"
                android:clipToOutline="true"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/participants_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="?attr/text_remarks"
                android:textSize="14sp"
                tools:text="5 Participants" />

            <EditText
                android:id="@+id/name_desc_et"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_round_white_8dp"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:hint="@string/Group_Name"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="25"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="?attr/text_primary"
                android:textColorHint="?attr/text_remarks"
                android:textSize="16sp"
                tools:ignore="Autofill" />

            <LinearLayout
                android:id="@+id/disappearing_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/disappearing_message"
                    android:textColor="?attr/text_assist"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/disappearing_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/disappearing_option_5"
                    android:textColor="?attr/text_remarks"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_gray_right" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/create_btn"
        style="@style/AppTheme.MaterialButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="20dp"
        android:minWidth="120dp"
        android:enabled="false"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/Create"
        android:textAllCaps="false"
        android:textFontWeight="400"
        android:textSize="16sp" />
</LinearLayout>
