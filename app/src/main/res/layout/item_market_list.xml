<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="10dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/favorite_iv"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/mixin_ripple_small"
        android:src="@drawable/ic_asset_favorites"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <one.mixin.android.widget.CircleImageView
        android:id="@+id/icon_iv"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/favorite_iv"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_avatar_place_holder" />

    <TextView
        android:id="@+id/symbol_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/text_primary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/volume_tv"
        app:layout_constraintStart_toEndOf="@id/icon_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="BTC-PERP" />

    <TextView
        android:id="@+id/leverage_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_round_4_solid_border_primary"
        android:paddingStart="3dp"
        android:paddingTop="1dp"
        android:paddingEnd="3dp"
        android:paddingBottom="1dp"
        android:textColor="?attr/text_assist"
        android:textFontWeight="500"
        android:textSize="12sp"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@id/symbol_tv"
        app:layout_constraintTop_toTopOf="@id/symbol_tv"
        app:layout_constraintBottom_toBottomOf="@id/symbol_tv"
        tools:text="100x" />

    <TextView
        android:id="@+id/volume_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/text_assist"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/symbol_tv"
        app:layout_constraintTop_toBottomOf="@id/symbol_tv"
        tools:text="VOL: $410.23M" />

    <TextView
        android:id="@+id/price_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="start"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="?attr/text_primary"
        android:textFontWeight="600"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/change_tv"
        app:layout_constraintStart_toEndOf="@id/leverage_tv"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="$42,123.45" />

    <TextView
        android:id="@+id/change_tv"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textFontWeight="600"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+2.34%"
        tools:textColor="@color/wallet_green" />

</androidx.constraintlayout.widget.ConstraintLayout>
