<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#13000000">
    <item
        android:id="@android:id/mask"
        android:bottom="@dimen/home_navigation_item_inset"
        android:left="@dimen/home_navigation_item_inset"
        android:right="@dimen/home_navigation_item_inset"
        android:top="@dimen/home_navigation_item_inset">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/home_navigation_item_corner_radius" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/home_navigation_item_inset"
        android:left="@dimen/home_navigation_item_inset"
        android:right="@dimen/home_navigation_item_inset"
        android:top="@dimen/home_navigation_item_inset">
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="#13000000" />
                    <corners android:radius="@dimen/home_navigation_item_corner_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
